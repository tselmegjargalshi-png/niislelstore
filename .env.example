# Нийслэл Стор: орчны хувьсагчид
# Энэ файлыг .env.local болгон хуулж, утгуудаа бөглөнө. .env.local файлыг хэзээ ч commit хийхгүй.

# ── Сайтын үндсэн тохиргоо ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Демо горим: "true" бол өгөгдөл хөтчийн localStorage дээр хадгалагдаж, демо админ нэвтрэлт ажиллана.
# Production дээр бодит өгөгдлийн сан холбосны дараа "false" болгоно.
NEXT_PUBLIC_DEMO_MODE=true

# ── Админ нэвтрэлт (server талд л уншигдана) ───────────────────────
# Cookie session гарын үсэг зурах нууц түлхүүр. Дор хаяж 32 тэмдэгт. Жишээ: openssl rand -base64 48
SESSION_SECRET=
# Админ (бүх эрхтэй) болон ажилтан (захиалга, нөөц) эрхийн нэвтрэх мэдээлэл.
# Хоосон бөгөөд демо горимд байвал README дээрх демо бүртгэлүүд ажиллана.
ADMIN_EMAIL=
ADMIN_PASSWORD=
STAFF_EMAIL=
STAFF_PASSWORD=

# ── Supabase (заавал биш) ──────────────────────────────────────────
# Тохируулбал өгөгдөл болон хэрэглэгчийн нэвтрэлт Supabase руу шилжинэ (supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role түлхүүрийг ЗӨВХӨН server талд хэрэглэнэ. NEXT_PUBLIC угтвар хэзээ ч бүү өг.
SUPABASE_SERVICE_ROLE_KEY=

# ── Төлбөрийн үйлчилгээ (албан ёсны гэрээ, credential авсны дараа) ──
# Хоосон байвал QPay, SocialPay нь ДЕМО горимоор ажиллаж, бодит гүйлгээ хийгдэхгүй.
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=

SOCIALPAY_BASE_URL=
SOCIALPAY_TERMINAL=
SOCIALPAY_SECRET=
SOCIALPAY_CALLBACK_URL=
